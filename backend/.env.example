# --- Database -------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (IPv4, port 5432)
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Offline dev: `uv run python -m scripts.dev_db` prints a local URL.
DATABASE_URL=

# --- Gemini (server-side only): default text models. https://aistudio.google.com/apikey
# Free tier: about 20 requests per day PER MODEL. Turn on billing for demos (costs cents).
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.7-flash,gemini-3.8-flash

# --- Agnes (server-side only, never sent to the browser): images + text fallback
AGNES_API_KEY=
# AGNES_TEXT_RPM=10
# AGNES_IMAGE_RPM=10

# --- Optional second OpenAI-compatible LLM (independent verifier / live model swap)
# Backups, tried in this order once Gemini models fail or run out (all free; save with scripts.set_secret):
# GEMINI_API_KEY_2=        a key from a different Google project (quota is per project)
# GROQ_API_KEY=            console.groq.com, no card
# CEREBRAS_API_KEY=        cloud.cerebras.ai, no card
# ALT_LLM_BASE_URL=
# ALT_LLM_API_KEY=
# ALT_LLM_MODEL=
# Role -> provider chain, comma separated; unconfigured names are skipped.
# ROLE_REASONING=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash,agnes
# ROLE_GENERATION=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.7-flash,agnes
# ROLE_VERIFICATION=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-3.6-flash,gemini-3.8-flash,agnes
# ROLE_IMAGE=agnes

# --- Demo safety -------------------------------------------------------------
# off | record | replay   (replayed outputs are labelled "Saved output" in the UI)
REPLAY_MODE=off

# --- Supabase: accounts and storage ---------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...): sign-in and session checks. Not secret, but only used server-side.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): creating accounts without an email round-trip, and Storage uploads.
# Set it with `uv run python -m scripts.set_secret SUPABASE_SERVICE_ROLE_KEY` (typed hidden, tested first).
SUPABASE_SERVICE_ROLE_KEY=
# local (dev) | supabase (deployed: containers have ephemeral disks)
STORAGE_BACKEND=local
# SUPABASE_BUCKET=campaign-assets

# --- Demo ----------------------------------------------------------------------
# "Try the demo" signs in as this shared account; it can open the demo business only.
# DEMO_EMAIL=demo@counterpart.app
DEMO_PASSWORD=

# --- Photos of the business itself ------------------------------------------------
# Google Maps Platform key with "Places API (New)" enabled: imports the business's Google Maps photos.
# Set with `uv run python -m scripts.set_secret GOOGLE_MAPS_API_KEY`. Website import and uploads work without it.
# GOOGLE_MAPS_API_KEY=
# AI picture when a business has no usable photo yet (labelled in the UI)
# AI_PICTURE_FALLBACK=true
# ROLE_VISION=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash

# --- Access ---------------------------------------------------------------------
# Shared secret between the Next.js server and this API, so the API only answers the frontend.
# OWNER_API_TOKEN=
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
