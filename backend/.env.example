# --- Database -------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (IPv4, port 5432)
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Offline dev: `uv run python -m scripts.dev_db` prints a local URL.
DATABASE_URL=

# --- Gemini (server-side only): default text models. https://aistudio.google.com/apikey
# Free tier: about 20 requests per day PER MODEL. Turn on billing for demos (costs cents).
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.7-flash,gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# --- Agnes (server-side only, never sent to the browser): images + text fallback
AGNES_API_KEY=
# AGNES_TEXT_RPM=10
# AGNES_IMAGE_RPM=10

# --- Optional second OpenAI-compatible LLM (independent verifier / live model swap)
# ALT_LLM_BASE_URL=
# ALT_LLM_API_KEY=
# ALT_LLM_MODEL=
# Role -> provider chain, comma separated; unconfigured names are skipped.
# ROLE_REASONING=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash,agnes
# ROLE_GENERATION=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,agnes
# ROLE_VERIFICATION=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite,agnes
# ROLE_IMAGE=agnes

# --- Demo safety -------------------------------------------------------------
# off | record | replay   (replayed outputs are labelled "Saved output" in the UI)
REPLAY_MODE=off

# --- Storage -------------------------------------------------------------------
# local (default) | supabase
STORAGE_BACKEND=local
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=        # server-side only
# SUPABASE_BUCKET=campaign-assets

# --- Access ---------------------------------------------------------------------
# If set, owner routes require X-Owner-Token (the Next.js server adds it).
# OWNER_API_TOKEN=
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
