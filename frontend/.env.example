# Server-side only (never prefixed with NEXT_PUBLIC_): where the FastAPI backend lives
BACKEND_URL=http://localhost:8000
# Must match OWNER_API_TOKEN in backend/.env if you set one there
OWNER_API_TOKEN=
# Optional: protect the owner UI with HTTP basic auth when deployed (QR landing pages stay public)
DEMO_USER=owner
DEMO_PASSWORD=
# Which business this workspace belongs to
NEXT_PUBLIC_BUSINESS_SLUG=kaapi-kone
